#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        caplock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <16 15>;
        };

        ctrl-v {
            bindings = <&kp RC(V)>;
            key-positions = <19 20>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 11>;
        };

        ctrl-c {
            bindings = <&kp RC(C)>;
            key-positions = <18 19>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp LALT   &kp Q             &kp W  &kp E  &kp R        &kp T                               &kp Y    &kp U      &kp I      &kp O    &mt EXCL P          &kp BSPC
&kp LSHFT  &kp A             &kp S  &kp D  &kp F        &kp G                               &kp H    &lt 3 J    &kp K      &kp L    &mt QUESTION MINUS  &kp ENTER
&kp LCTRL  &mt LEFT_SHIFT Z  &kp X  &kp C  &lt 4 V      &kp B        &kp LGUI     &kp DEL   &kp N    &kp M      &kp COMMA  &kp DOT  &kp RC(C)           &kp RC(V)
                                           &lt 1 SPACE  &lt 2 SPACE  &kp SPACE    &kp BSPC  &kp RET  &kp SPACE
            >;
        };

        number {
            bindings = <
&kp ESCAPE    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                    &kp NUMBER_6  &kp N7  &kp N8  &kp N9  &kp N0   &kp GRAVE
&kp LEFT_WIN  &kp N6        &kp N7        &kp N8        &kp N9        &kp N0                          &kp F1        &kp F2  &kp F3  &kp F4  &kp F5   &kp TILDE
&trans        &kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &trans    &trans  &kp F6        &kp F7  &kp F8  &kp F9  &kp F10  &trans
                                                        &mo 4         &trans        &trans    &trans  &trans        &trans
            >;
        };

        kigou {
            bindings = <
&trans  &trans  &trans     &trans      &trans  &trans                    &kp CARET         &kp AMPERSAND      &kp PRCNT             &kp MINUS              &kp UNDER  &kp AT
&trans  &kp AT  &kp HASH   &kp DOLLAR  &trans  &trans                    &kp LESS_THAN     &kp GREATER_THAN   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL  &kp BSLH
&trans  &trans  &kp ASTRK  &kp CARET   &trans  &trans  &trans    &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp FSLH   &kp PLUS
                                       &trans  &trans  &trans    &trans  &trans            &trans
            >;
        };

        arrow {
            bindings = <
&trans     &kp Q      &kp W   &kp E  &kp R           &kp T                                 &kp Y           &kp U   &kp I   &kp O   &kp P   &trans
&trans     &kp A      &kp S   &kp D  &kp F           &kp G                                 &kp UP_ARROW    &trans  &trans  &trans  &trans  &trans
&kp LCTRL  &kp LSHFT  &kp F2  &kp I  &kp O           &kp B      &trans             &trans  &kp DOWN_ARROW  &trans  &trans  &trans  &trans  &trans
                                     &kp LEFT_ARROW  &kp SPACE  &kp RIGHT_ARROW    &trans  &trans          &trans
            >;
        };

        bluetooth {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &studio_unlock
&trans  &trans  &trans  &trans  &trans  &trans                    &trans        &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans        &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
                                &trans  &trans  &trans    &trans  &trans        &trans
            >;
        };
    };
};
