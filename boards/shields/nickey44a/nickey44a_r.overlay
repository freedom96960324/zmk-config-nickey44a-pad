#include "nickey44a.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/nrf-pinctrl.h>
#include <dt-bindings/zmk/keys.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/*
 * yuPad43 (IQS9151) wiring — same XIAO pins as the former TPS43 breakout:
 *   yuPad43 pin 6 SDA  = XIAO NFC1/P0.09
 *   yuPad43 pin 5 SCL  = XIAO P1.01
 *   yuPad43 pin 1 RDY  = XIAO P0.15 (active-low)
 *   yuPad43 pin 2 RST  = XIAO P0.19 (not driven; the driver uses soft reset)
 *   yuPad43 pin 4 3V3  = XIAO 3V3
 *   yuPad43 pin 3 GND  = XIAO GND
 */

&uicr {
    nfct-pins-as-gpios;
};

&pinctrl {
    nickey44a_yupad_i2c0_default: nickey44a_yupad_i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 9)>,
                    <NRF_PSEL(TWIM_SCL, 1, 01)>;
        };
    };

    nickey44a_yupad_i2c0_sleep: nickey44a_yupad_i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 9)>,
                    <NRF_PSEL(TWIM_SCL, 1, 01)>;
            low-power-enable;
        };
    };
};

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        left_yupad_split: left_yupad_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    /*
     * Three-finger swipe from the IQS9151 driver:
     *   swipe right -> BTN_3, swipe left -> BTN_4.
     * Converted to browser tab switching.
     */
    yupad_tab_swipe: yupad_tab_swipe {
        compatible = "zmk,input-processor-behaviors";
        #input-processor-cells = <0>;
        type = <INPUT_EV_KEY>;
        codes = <INPUT_BTN_3 INPUT_BTN_4>;
        bindings = <&kp LC(TAB) &kp LC(LS(TAB))>;
    };

    /* Left yuPad43 (forwarded from the left half). */
    left_yupad_listener: left_yupad_listener {
        compatible = "zmk,input-listener";
        device = <&left_yupad_split>;
        input-processors = <&zip_scroll_scaler 1 12>, <&yupad_tab_swipe>;
    };

    /* Right yuPad43. Three-finger swipe = mouse back/forward buttons by default. */
    yupad_listener: yupad_listener {
        compatible = "zmk,input-listener";
        device = <&yupad>;
        input-processors = <&zip_scroll_scaler 1 12>;

        snipe_layer {
            layers = <1>;
            process-next;
            /* Layer 1: three-finger swipe switches tabs, cursor slowed to 2/3. */
            input-processors = <&yupad_tab_swipe>, <&zip_xy_scaler 2 3>;
        };
    };
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&nickey44a_yupad_i2c0_default>;
    pinctrl-1 = <&nickey44a_yupad_i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    #address-cells = <1>;
    #size-cells = <0>;

    yupad: iqs9151@56 {
        compatible = "azoteq,iqs9151";
        reg = <0x56>;
        status = "okay";
        irq-gpios = <&gpio0 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};

&default_transform {
    col-offset = <6>;
};

&kscan0 {
        col-gpios
            = <&xiao_d 1 GPIO_ACTIVE_HIGH>
            , <&xiao_d 2 GPIO_ACTIVE_HIGH>
            , <&xiao_d 3 GPIO_ACTIVE_HIGH>
            , <&xiao_d 4 GPIO_ACTIVE_HIGH>
            , <&xiao_d 5 GPIO_ACTIVE_HIGH>
            , <&xiao_d 6 GPIO_ACTIVE_HIGH>
            ;
};
