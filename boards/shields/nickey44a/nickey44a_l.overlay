#include "nickey44a.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/*
 * yuPad43 (IQS9151) wiring — same XIAO pins as the former TPS43 breakout:
 *   yuPad43 pin 6 SDA  = XIAO NFC1/P0.09
 *   yuPad43 pin 5 SCL  = XIAO P1.01
 *   yuPad43 pin 1 RDY  = XIAO P0.15 (active-low)
 *   yuPad43 pin 2 RST  = XIAO P0.19 (not driven; the driver uses soft reset)
 *   yuPad43 pin 4 3V3  = XIAO 3V3
 *   yuPad43 pin 3 GND  = XIAO GND
 */

&uicr {
    nfct-pins-as-gpios;
};

&pinctrl {
    nickey44a_left_yupad_i2c0_default: nickey44a_left_yupad_i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 9)>,
                    <NRF_PSEL(TWIM_SCL, 1, 01)>;
        };
    };

    nickey44a_left_yupad_i2c0_sleep: nickey44a_left_yupad_i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 9)>,
                    <NRF_PSEL(TWIM_SCL, 1, 01)>;
            low-power-enable;
        };
    };
};

/ {
    /* Left pad: two-finger left/right motion is dropped (DIAL is ignored by the host side). */
    left_hwheel_drop: left_hwheel_drop {
        compatible = "zmk,input-processor-code-mapper";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        map = <INPUT_REL_HWHEEL INPUT_REL_DIAL>;
    };

    /* Left pad: two-finger up/down becomes horizontal scroll. */
    left_wheel_to_hwheel: left_wheel_to_hwheel {
        compatible = "zmk,input-processor-code-mapper";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        map = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
    };

    /* Left pad: two-finger tap (BTN_1) becomes middle click. */
    left_middle_click_mapper: left_middle_click_mapper {
        compatible = "zmk,input-processor-code-mapper";
        #input-processor-cells = <0>;
        type = <INPUT_EV_KEY>;
        map = <INPUT_BTN_1 INPUT_BTN_2>;
    };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        left_yupad_split: left_yupad_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
            device = <&left_yupad>;
            /* Left pad does not move the cursor. Order matters: drop HWHEEL before remapping WHEEL. */
            input-processors = <&zip_xy_scaler 0 1>,
                               <&left_hwheel_drop>,
                               <&left_wheel_to_hwheel>,
                               <&left_middle_click_mapper>;
        };
    };
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&nickey44a_left_yupad_i2c0_default>;
    pinctrl-1 = <&nickey44a_left_yupad_i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    #address-cells = <1>;
    #size-cells = <0>;

    left_yupad: iqs9151@56 {
        compatible = "azoteq,iqs9151";
        reg = <0x56>;
        status = "okay";
        irq-gpios = <&gpio0 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};

&kscan0 {
        col-gpios
            = <&xiao_d 1 GPIO_ACTIVE_HIGH>
            , <&xiao_d 2 GPIO_ACTIVE_HIGH>
            , <&xiao_d 3 GPIO_ACTIVE_HIGH>
            , <&xiao_d 4 GPIO_ACTIVE_HIGH>
            , <&xiao_d 5 GPIO_ACTIVE_HIGH>
            , <&xiao_d 6 GPIO_ACTIVE_HIGH>
            ;
};

